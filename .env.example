# Local development:
# Save as .env.development or keep using .env.dev
APP_ENV=development
BOT_TOKEN=your-development-discord-bot-token
CLIENT_ID=your-development-discord-application-id
GUILD_ID=your-development-discord-guild-id
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/dev?retryWrites=true&w=majority
# Optional local fallback when SRV DNS lookup is blocked:
# MONGO_DIRECT_URI=mongodb://username:password@host1,host2,host3/dev?replicaSet=atlas-xxxxx-shard-0&ssl=true&authSource=admin&retryWrites=true&w=majority
WEB_PORT=3000
COMMAND_SCOPE=guild
REGISTER_COMMANDS=true
# Optional development battle timeout in minutes (default: 30).
# BATTLE_TIMEOUT_MINUTES=30

# Production:
# Use Heroku config vars instead of committing a file.
# APP_ENV=production
# BOT_TOKEN=your-production-discord-bot-token
# CLIENT_ID=your-production-discord-application-id
# GUILD_ID=your-production-discord-guild-id
# MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/main?retryWrites=true&w=majority
# MONGO_DIRECT_URI=mongodb://username:password@host1,host2,host3/main?replicaSet=atlas-xxxxx-shard-0&ssl=true&authSource=admin&retryWrites=true&w=majority
# WEB_PORT=3000
# COMMAND_SCOPE=guild
# REGISTER_COMMANDS=true
